# Things MCP Server Configuration

# Transport type: "stdio" (default) or "http"
# THINGS_MCP_TRANSPORT=stdio

# HTTP server configuration (only used when THINGS_MCP_TRANSPORT=http)
# THINGS_MCP_HOST=127.0.0.1
# THINGS_MCP_PORT=8000

# How long create tools wait for the new item's ID, in milliseconds. Confirming
# a create costs roughly half a second; set this to 0 to skip the lookup entirely
# and have creates return immediately with a null ID, as they did before IDs were
# returned. Individual calls can still override it with the wait_ms parameter.
# THINGS_MCP_CREATE_WAIT_MS=1500

# Authentication for the HTTP transport: "none" (default) or "password".
# Authentication never applies to stdio, which is secured by local execution.
#
# "password" runs a self-contained OAuth 2.1 authorization server guarded by a
# single shared password. Use it when the server is reachable from the public
# internet and clients (such as a Claude connector) can only be given a URL.
# THINGS_MCP_AUTH=none

# The shared password, required when THINGS_MCP_AUTH=password. Use a long random
# value -- it is the only credential protecting the server. For example:
#   python3 -c "import uuid; print(uuid.uuid4())"
# THINGS_MCP_PASSWORD=

# The public URL clients reach this server on, required when
# THINGS_MCP_AUTH=password. This becomes the OAuth issuer and must match what
# clients dial exactly, including the scheme. Getting it wrong produces a 401
# that does not explain itself.
# THINGS_MCP_BASE_URL=https://things.example.com

# Where registered clients and issued tokens are persisted, so that a restart
# does not force every client to authorize again. Defaults to ~/.things-mcp.
# THINGS_MCP_STATE_DIR=~/.things-mcp
